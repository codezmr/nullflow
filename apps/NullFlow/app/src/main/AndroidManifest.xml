<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Haptic feedback on the hero toggle -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Focus timer notification (Android 13+ runtime permission) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Keep the VPN tunnel alive as a foreground service (Android 12+) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- Populate the app picker with the user's installed apps.
         QUERY_ALL_PACKAGES is required on Android 11+ to see all packages.
         (Play Store scrutiny item — fine for sideloaded APK.) -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.NullFlow">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.NullFlow">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The "Local Privacy Shield" engine. BIND_VPN_SERVICE is the system
             permission Android checks before letting us create a VPN tunnel.
             The system consent dialog is triggered via VpnService.prepare(). -->
        <service
            android:name=".vpn.FocusVpnService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="dataSync"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>

        <!-- GhostShield: the Quick Settings tile. Tapping it opens the native
             Compose Focus Panel over the current app. BIND_QUICK_SETTINGS_TILE
             is the system permission Android checks before showing the tile. -->
        <service
            android:name=".tile.FocusTileService"
            android:label="GhostShield"
            android:icon="@drawable/ic_hero_toggle"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
    </application>

</manifest>
